# Backend Server Config (Default Local Persistent SQLite Backend)
PORT=3001
TASKLY_DB_PATH=./data/taskly.db
TASKLY_AUTH_SECRET=replace-with-random-secret-in-production

# Optional: Enable Supabase Cloud Backend Adapter (leave empty to use built-in SQLite REST API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
